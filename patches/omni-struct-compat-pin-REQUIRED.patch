From 3960948ad6ce1b91246265ce113bd05b1bdb898d Mon Sep 17 00:00:00 2001
From: Richard Rodger <richard@ricebridge.com>
Date: Wed, 26 Aug 2026 11:49:25 +0000
Subject: [PATCH] ci: pin struct-compat's checkout, so its red means omni
 (register 0.5)

struct-compat runs voxgig/struct's JavaScript suite against omni's
runner, and checked struct out unpinned. That gave a red run three
possible causes - omni regressed, struct's library regressed, or
struct's tests moved - of which only the first is actionable in this
repo. Pinning to a SHA leaves exactly that one.

Register item 0.5, which asked for precisely this and named the reason:
a consumer can already pin the checkout, so nothing but the doing of it
was missing.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0134DkQn3dstjGHi7fwTiry1
---
 .github/workflows/ci.yml | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index e62f484..4b9fc90 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -28,6 +28,15 @@ concurrency:
 permissions:
   contents: read
 
+env:
+  # struct-compat runs voxgig/struct's own JavaScript suite against omni's
+  # runner, so it checks that repo out. Pinned to a SHA rather than floating
+  # on struct's default branch: unpinned, a red run has three possible causes
+  # - omni regressed, struct's library regressed, or struct's tests moved -
+  # and only the first is actionable here. Pinning leaves just that one.
+  # Bump this line to gate against a newer struct. (Register item 0.5.)
+  STRUCT_REF: 9386f9de38eb6901f17994e7c0089443c3e656f3
+
 jobs:
   # Ports whose toolchain ships with ubuntu-latest, or installs in one
   # apt line. Grouped so 23 languages do not mean 23 near-identical blocks.
@@ -310,6 +319,7 @@ jobs:
         with:
           repository: voxgig/struct
           path: .struct
+          ref: ${{ env.STRUCT_REF }}
       - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7
         with:
           node-version: '24'
-- 
2.43.0

