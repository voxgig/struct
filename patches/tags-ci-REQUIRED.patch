From a6ec1a37103fe6e7a21c45a40f714c6790281fac Mon Sep 17 00:00:00 2001
From: Richard Rodger <richard@ricebridge.com>
Date: Wed, 26 Aug 2026 22:27:40 +0000
Subject: [PATCH] ci: clojure, dart, lean and rust take omni from its tag, not
 a checkout

Each of the four now names a release in its own manifest, so the omni
checkout these eight jobs carried is dead weight - and for lean it was worse
than dead: `make omni-fetch` treats $OMNI_HOME as an OVERRIDE, so leaving it
set would have quietly kept that job on a floating checkout while the
Makefile advertised a pinned tag.

test-rust keeps its "Library builds without omni" step and gains meaning from
the change: there is no longer any state in which omni is present for the
library's build, since corpus/Cargo.toml resolves it from `rust/v0.1.0`.

lint-dart drops its `dart pub get &&` prefix too - `make lint` depends on the
`deps` target now, which is the same command.

test-haskell and lint-haskell keep their checkout: haskell is not part of this
change and reaches omni by `-i$(OMNI_DIR)/haskell/src` on the test search path.
OMNI_REF stays for them and for the other ports still on a checkout.
---
 .github/workflows/build.yml | 58 ++++++++-----------------------------
 .github/workflows/lint.yml  | 47 ++++++------------------------
 2 files changed, 21 insertions(+), 84 deletions(-)

diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
index c604c57..ec793f9 100644
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -229,21 +229,13 @@ jobs:
           toolchain: stable
       # Register 4.13: the corpus harness is a separate package (`rust/corpus`)
       # so that omni stays out of the library's manifest. Cargo resolves
-      # dev-dependencies even for `cargo build`, so this must pass with NO omni
-      # checkout present - checked here, before omni is fetched.
+      # dev-dependencies even for `cargo build`, so this must pass with omni
+      # nowhere in the library's graph - which is now the only state there is,
+      # since `corpus/Cargo.toml` takes omni from its `rust/v0.1.0` tag and
+      # nothing checks omni out here at all.
       - name: Library builds without omni
         working-directory: ./rust
         run: cargo build --all-targets
-      # The test runner is voxgig/omni, consumed as a local checkout (it is not
-      # published to crates.io). Cargo path dependencies are literal and cannot
-      # read $OMNI_HOME, so the checkout goes exactly where `corpus/Cargo.toml`
-      # names it.
-      - name: Checkout voxgig/omni (test runner)
-        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
-        with:
-          repository: voxgig/omni
-          path: .omni
-          ref: ${{ env.OMNI_REF }}
       - name: Run tests
         working-directory: ./rust
         run: cargo test
@@ -626,15 +618,8 @@ jobs:
         os: [ubuntu-latest, macos-latest, windows-latest]
     steps:
       - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
-      # The test runner is voxgig/omni, consumed as a local checkout (it is
-      # not published to Clojars); the Makefile mints an :omni alias for it
-      # from OMNI_HOME. The library itself never depends on omni.
-      - name: Checkout voxgig/omni (test runner)
-        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
-        with:
-          repository: voxgig/omni
-          path: .omni
-          ref: ${{ env.OMNI_REF }}
+      # No omni checkout: deps.edn declares it in the :omni alias at its
+      # clojure/v0.1.0 tag, and the Clojure CLI fetches it.
       - uses: actions/setup-java@b6effb05e454b25005698d916606bdc6ffcbf961 # v5
         with:
           distribution: temurin
@@ -649,8 +634,6 @@ jobs:
         working-directory: ./clojure
         shell: bash
         run: make test
-        env:
-          OMNI_HOME: ${{ github.workspace }}/.omni
 
   test-dart:
     runs-on: ${{ matrix.os }}
@@ -659,16 +642,8 @@ jobs:
         os: [ubuntu-latest, macos-latest, windows-latest]
     steps:
       - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
-      # The test runner is voxgig/omni, consumed as a local checkout (it is
-      # not published to pub.dev); the Makefile writes it into a generated
-      # pubspec_overrides.yaml from OMNI_HOME. The library itself never
-      # depends on omni.
-      - name: Checkout voxgig/omni (test runner)
-        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
-        with:
-          repository: voxgig/omni
-          path: .omni
-          ref: ${{ env.OMNI_REF }}
+      # No omni checkout: pubspec.yaml declares it under dev_dependencies at
+      # its dart/v0.1.0 tag, and `dart pub get` fetches it.
       - uses: dart-lang/setup-dart@65eb853c7ba17dde3be364c3d2858773e7144260 # v1
       - name: Install make (Windows)
         if: runner.os == 'Windows'
@@ -677,8 +652,6 @@ jobs:
         working-directory: ./dart
         shell: bash
         run: make test
-        env:
-          OMNI_HOME: ${{ github.workspace }}/.omni
 
   test-elixir:
     runs-on: ${{ matrix.os }}
@@ -782,15 +755,10 @@ jobs:
         os: [ubuntu-latest, macos-latest, windows-latest]
     steps:
       - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
-      # The test runner is voxgig/omni, consumed as a local checkout (it is
-      # not published); the Makefile copies its Omni.lean in from OMNI_HOME.
-      # The library itself never depends on omni.
-      - name: Checkout voxgig/omni (test runner)
-        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
-        with:
-          repository: voxgig/omni
-          path: .omni
-          ref: ${{ env.OMNI_REF }}
+      # No omni checkout, and no OMNI_HOME: `make omni-fetch` takes Omni.lean
+      # from the lean/v0.1.0 tag and refuses a tag that no longer resolves to
+      # the pinned sha. OMNI_HOME would OVERRIDE that, so setting it here
+      # would quietly put this job back on a floating checkout.
       # elan directly rather than leanprover/lean-action: that action is a
       # composite that references actions/cache/restore@v5 and
       # actions/cache/save@v5 BY TAG internally, and the SHA-pin rule applies
@@ -843,8 +811,6 @@ jobs:
         working-directory: ./lean
         shell: bash
         run: make test
-        env:
-          OMNI_HOME: ${{ github.workspace }}/.omni
 
   # boru had no CI job at all, which is how the port spent two days broken on
   # an engine rename without anyone noticing (boru/AGENTS.md records it). This
diff --git a/.github/workflows/lint.yml b/.github/workflows/lint.yml
index 368040c..36971c5 100644
--- a/.github/workflows/lint.yml
+++ b/.github/workflows/lint.yml
@@ -93,13 +93,8 @@ jobs:
           toolchain: stable
           components: clippy, rustfmt
       # `make lint` clippies the corpus harness too, and that package depends
-      # on omni - so the checkout is needed here as well as in the test job.
-      - name: Checkout voxgig/omni (test runner)
-        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
-        with:
-          repository: voxgig/omni
-          path: .omni
-          ref: ${{ env.OMNI_REF }}
+      # on omni - taken from its rust/v0.1.0 tag, so there is nothing to check
+      # out for it.
       - working-directory: ./rust
         run: make lint
 
@@ -291,14 +286,8 @@ jobs:
     steps:
       - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
       # `make lint` type-checks the corpus runner too, and that names
-      # voxgig/omni - a local checkout, not a published package. Same step
-      # lint-go already carries; the library itself never depends on omni.
-      - name: Checkout voxgig/omni (test runner)
-        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
-        with:
-          repository: voxgig/omni
-          path: .omni
-          ref: ${{ env.OMNI_REF }}
+      # voxgig/omni - taken from its clojure/v0.1.0 tag, so there is nothing
+      # to check out for it.
       - uses: actions/setup-java@b6effb05e454b25005698d916606bdc6ffcbf961 # v5
         with:
           distribution: temurin
@@ -308,27 +297,17 @@ jobs:
           cli: latest
       - working-directory: ./clojure
         run: make lint
-        env:
-          OMNI_HOME: ${{ github.workspace }}/.omni
 
   lint-dart:
     runs-on: ubuntu-latest
     steps:
       - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
       # `make lint` type-checks the corpus runner too, and that names
-      # voxgig/omni - a local checkout, not a published package. Same step
-      # lint-go already carries; the library itself never depends on omni.
-      - name: Checkout voxgig/omni (test runner)
-        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
-        with:
-          repository: voxgig/omni
-          path: .omni
-          ref: ${{ env.OMNI_REF }}
+      # voxgig/omni - taken from its dart/v0.1.0 tag, so there is nothing to
+      # check out for it.
       - uses: dart-lang/setup-dart@65eb853c7ba17dde3be364c3d2858773e7144260 # v1
       - working-directory: ./dart
-        run: dart pub get && make lint
-        env:
-          OMNI_HOME: ${{ github.workspace }}/.omni
+        run: make lint
 
   lint-elixir:
     runs-on: ubuntu-latest
@@ -378,14 +357,8 @@ jobs:
     steps:
       - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
       # `make lint` type-checks the corpus runner too, and that names
-      # voxgig/omni - a local checkout, not a published package. Same step
-      # lint-go already carries; the library itself never depends on omni.
-      - name: Checkout voxgig/omni (test runner)
-        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
-        with:
-          repository: voxgig/omni
-          path: .omni
-          ref: ${{ env.OMNI_REF }}
+      # voxgig/omni - fetched from its lean/v0.1.0 tag by `make omni-fetch`.
+      # No OMNI_HOME either: it would override the tag.
       # elan directly rather than leanprover/lean-action: that action is a
       # composite that references actions/cache/restore@v5 and
       # actions/cache/save@v5 BY TAG internally, and the SHA-pin rule applies
@@ -433,5 +406,3 @@ jobs:
           echo "$HOME/.elan/bin" >> "$GITHUB_PATH"
       - working-directory: ./lean
         run: make lint
-        env:
-          OMNI_HOME: ${{ github.workspace }}/.omni
-- 
2.43.0

